# Copy this file to .env and fill in your keys

# ── Mock mode ────────────────────────────────────────────────────────────────
# Set to true to run without PTV credentials.
# Simulated trams cycle all routes, arrivals fire every ~8 seconds.
# Adjust SECONDS_PER_STOP in src/mock/simulator.js to change density.
VITE_USE_MOCK=true

# ── Mapbox ────────────────────────────────────────────────────────────────────
# Required even in mock mode (the map still renders). Free tier is plenty.
# https://account.mapbox.com/
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here

# ── PTV API (not needed while VITE_USE_MOCK=true) ────────────────────────────
# https://www.ptv.vic.gov.au/footer/data-and-reporting/datasets/ptv-timetable-api/
VITE_PTV_DEV_ID=your_dev_id_here
VITE_PTV_API_KEY=your_api_key_here
